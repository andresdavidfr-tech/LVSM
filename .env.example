# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Formulario "Select Club" (form propio, postea a Google Forms) ---
# Ver docs/SELECT_CLUB_FORM_SETUP.md para crear el formulario y conseguir
# estos valores con el "link prellenado" de Google Forms. Faltando cualquiera
# de los primeros 6, esa sección muestra un aviso de "pendiente de
# configurar" en vez de un formulario roto.
VITE_GOOGLE_FORM_ACTION="https://docs.google.com/forms/d/e/TU_ID/formResponse"
VITE_GOOGLE_FORM_ENTRY_NAME="entry.111111111"
VITE_GOOGLE_FORM_ENTRY_EMAIL="entry.222222222"
VITE_GOOGLE_FORM_ENTRY_PHONE="entry.333333333"
VITE_GOOGLE_FORM_ENTRY_INTEREST="entry.444444444"
VITE_GOOGLE_FORM_ENTRY_MESSAGE="entry.555555555"
# Cumpleaños: usar SOLO UNA de las dos opciones de abajo, según cómo Google
# exponga el campo en tu formulario (ver guía) — dejar la otra vacía/sin usar.
VITE_GOOGLE_FORM_ENTRY_BIRTHDAY="entry.666666666"
# VITE_GOOGLE_FORM_ENTRY_BIRTHDAY_MONTH="entry.666666666_month"
# VITE_GOOGLE_FORM_ENTRY_BIRTHDAY_DAY="entry.666666666_day"

# --- Amazon S3 (almacenamiento de imágenes de producto) ---
# El frontend arma URLs públicas así:
#   https://<VITE_S3_BUCKET>.s3.<VITE_S3_REGION>.amazonaws.com/<key>
# Requisitos: el bucket/objetos deben tener lectura pública (ver README).
# Setear SOLO después de subir las imágenes; si no, se usa el fallback.
VITE_S3_BUCKET="lvsm-847008501986-us-east-1-an"
VITE_S3_REGION="us-east-1"
# Opcional: base custom (CloudFront / dominio propio); tiene prioridad sobre S3.
# VITE_IMAGE_BASE_URL="https://cdn.tudominio.com"

# --- Subida desde el Admin (SERVER-SIDE, secreto: NO usar prefijo VITE_) ---
# Credenciales IAM con permiso s3:PutObject sobre el bucket. El servidor las usa
# para firmar las subidas; nunca llegan al navegador. Cargar en el host/Vercel.
AWS_ACCESS_KEY_ID="MY_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="MY_AWS_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"
S3_BUCKET="lvsm-847008501986-us-east-1-an"
