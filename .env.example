# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Agente de WhatsApp (responde preguntas de catálogo automáticamente) ---
# Ver docs/WHATSAPP_BOT_SETUP.md para la guía paso a paso de cómo conseguir
# estos valores en Meta for Developers.
ANTHROPIC_API_KEY="sk-ant-..."
WHATSAPP_TOKEN="tu-token-de-acceso-permanente-de-meta"
WHATSAPP_PHONE_NUMBER_ID="el-id-del-numero-de-whatsapp-no-el-numero"
WHATSAPP_VERIFY_TOKEN="inventá-cualquier-string-secreta-vos-mismo"

# --- Acceso al panel /admin (freno temporal, NO es seguridad real) ---
# Contraseña simple para frenar el acceso casual a /admin mientras no haya
# autenticación real del lado del servidor. Viaja en el bundle del navegador:
# cualquiera con conocimientos técnicos puede sortearla. Reemplazar por auth
# de servidor antes de manejar datos sensibles reales en ese panel.
# Sin esta variable seteada, NADIE puede entrar a /admin (queda cerrado).
VITE_ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# --- Amazon S3 (almacenamiento de imágenes de producto) ---
# El frontend arma URLs públicas así:
#   https://<VITE_S3_BUCKET>.s3.<VITE_S3_REGION>.amazonaws.com/<key>
# Requisitos: el bucket/objetos deben tener lectura pública (ver README).
# Setear SOLO después de subir las imágenes; si no, se usa el fallback.
VITE_S3_BUCKET="lvsm-847008501986-us-east-1-an"
VITE_S3_REGION="us-east-1"
# Opcional: base custom (CloudFront / dominio propio); tiene prioridad sobre S3.
# VITE_IMAGE_BASE_URL="https://cdn.tudominio.com"

# --- Subida desde el Admin (SERVER-SIDE, secreto: NO usar prefijo VITE_) ---
# Credenciales IAM con permiso s3:PutObject sobre el bucket. El servidor las usa
# para firmar las subidas; nunca llegan al navegador. Cargar en el host/Vercel.
AWS_ACCESS_KEY_ID="MY_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="MY_AWS_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"
S3_BUCKET="lvsm-847008501986-us-east-1-an"
